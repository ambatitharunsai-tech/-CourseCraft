# Copy this file to .env for local development; never put real secrets in Git.
SECRET_KEY=replace-with-a-long-random-secret
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GOOGLE_CLIENT_ID=
# Local SQLite default. For production, replace with a PostgreSQL connection URI.
DATABASE_URL=sqlite:///history.db
LOG_LEVEL=INFO
